# Feature flags
WAITLIST_MODE=false         # false: produto no ar (cadastro e app abertos) · true: só lista de espera
AGENT_MODE=mock             # mock | live
BILLING_MODE=mock           # mock: pagamentos e créditos simulados no navegador | live: Supabase + gateway

# Supabase (públicas — vão para o navegador)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Analytics (opcional). Se preenchido com um pixel de marketing, o banner de cookies aparece.
VITE_ANALYTICS_PIXEL_ID=
VITE_SITE_URL=https://thoran.com.br
