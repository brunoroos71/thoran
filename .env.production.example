# Copie para .env.production.local (não vai para o git) e preencha. Usado por scripts/go-live.sh.
SITE_URL=https://thoran.com.br

# Supabase › Project Settings › API
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe › Developers › API keys / Webhooks (comece com sk_test_ e whsec_ do modo teste)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend › API Keys (e verifique o domínio do remetente)
RESEND_API_KEY=
EMAIL_FROM=Thoran <ola@thoran.com.br>

# Flags do site
WAITLIST_MODE=false    # false: produto no ar · true: só lista de espera
AGENT_MODE=mock        # mock até a API do agente ficar pronta

# Agente real (quando existir)
AGENT_API_URL=
AGENT_API_KEY=
